+fn spawn_stderr_logger(mut err: impl Read + Send + 'static) {
+    std::thread::spawn(move || {
+        let mut buf = [0u8; 2048];
+        loop {
+            match err.read(&mut buf) {
+                Ok(0) | Err(_) => break,
+                Ok(n) => {
+                    let line = String::from_utf8_lossy(&buf[..n]);
+                    for l in line.lines() {
+                        if !l.trim().is_empty() {
+                            info!(target: "whep_demux", "{l}", l = l);
+                        }
+                    }
+                }
+            }
+        }
+    });
+}
+
+/// Block until demux prints `WHEP_READY` on stderr, or fail if it exits / times out.
+fn wait_whep_ready(
+    stderr: &mut impl Read,
+    child: &mut std::process::Child,
+    timeout: Duration,
+) -> Result<()> {
+    use std::io::BufRead;
+    use std::os::unix::io::AsRawFd;
+    let deadline = Instant::now() + timeout;
+    let mut reader = std::io::BufReader::new(stderr);
+    let mut line = String::new();
+    let fd = reader.get_ref().as_raw_fd();
+    let flags = unsafe { libc::fcntl(fd, libc::F_GETFL) };
+    if flags >= 0 {
+        unsafe {
+            let _ = libc::fcntl(fd, libc::F_SETFL, flags | libc::O_NONBLOCK);
+        }
+    }
+    loop {
+        if Instant::now() >= deadline {
+            let _ = child.kill();
+            let _ = child.wait();
+            bail!("WHEP demux timed out waiting for WHEP_READY (fix demux/deps/ICE — do not fall back to HLS)");
+        }
+        match child.try_wait() {
+            Ok(Some(status)) => {
+                let mut rest = String::new();
+                let _ = reader.read_to_string(&mut rest);
+                bail!(
+                    "WHEP demux exited before ready ({status}): {}",
+                    rest.chars().take(400).collect::<String>()
+                );
+            }
+            Ok(None) => {}
+            Err(e) => bail!("WHEP demux wait: {e}"),
+        }
+        line.clear();
+        match reader.read_line(&mut line) {
+            Ok(0) => std::thread::sleep(Duration::from_millis(40)),
+            Ok(_) => {
+                let t = line.trim();
+                if !t.is_empty() {
+                    info!(target: "whep_demux", "{t}", t = t);
+                }
+                if t == "WHEP_READY" || t.ends_with("WHEP_READY") {
+                    return Ok(());
+                }
+            }
+            Err(e) if e.kind() == std::io::ErrorKind::WouldBlock => {
+                std::thread::sleep(Duration::from_millis(40));
+            }
+            Err(e) => bail!("WHEP demux stderr: {e}"),
+        }
+    }
+}
